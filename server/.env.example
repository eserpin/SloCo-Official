# Local server environment
PORT=5000
BACKEND_URL=http://localhost:5000/

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Shipping
SHIPPO_TOKEN=shippo_test_your_shippo_token

# Email
GMAIL_USER=slow.comics.publishing@gmail.com
GMAIL_APP_PASS=your_gmail_app_password
EMAIL_USER=slow.comics.publishing@gmail.com

# Cloudflare R2 / S3-compatible storage
CF_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CF_ACCESS=your_r2_access_key_id
CF_SECRET=your_r2_secret_access_key

# Google Drive PDF downloads
GDRIVE_FILE_ID=your_google_drive_file_id
PDF_SERVICE_KEY={"type":"service_account","project_id":"your-project-id"}
